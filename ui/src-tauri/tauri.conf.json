{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "l2t-cockpit",
  "version": "0.1.0",
  "identifier": "io.github.coldsimens78.l2t-cockpit",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5199",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "L2T SPIKE",
        "width": 1100,
        "height": 760,
        "resizable": true,
        "fullscreen": false,
        "url": "spike.html",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}